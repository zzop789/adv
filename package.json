{
  "name": "adv-pc-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Offline Windows ADV framework",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "start": "npm run build && node tools/start.mjs",
    "start:built": "node tools/start.mjs",
    "build": "npm run typecheck && vite build && node tools/build-desktop.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:smoke": "npm run build && node tools/smoke.mjs",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "esbuild": "0.28.2",
    "playwright": "^1.58.0",
    "tsx": "^4.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
